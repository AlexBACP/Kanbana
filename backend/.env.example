# App
NODE_ENV=development
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=kanbana_user
DB_PASSWORD=
DB_NAME=kanbana_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# Archivos (local dev)
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173

# IA — Gemini (gratis: aistudio.google.com)
GEMINI_API_KEY=

# IA — Ollama (local dev) / Groq (producción)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=

# Supabase Storage (producción)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=kanbana-uploads

# ── Integración GitHub ──────────────────────────────────────────────────────
# OAuth App en https://github.com/settings/developers
#   Authorization callback URL = http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:3000/api/github/callback
# URL pública del webhook (usa un túnel como ngrok en local)
GITHUB_WEBHOOK_URL=http://localhost:3000/api/github/webhook
# Clave de cifrado de tokens (32+ chars; fallback: JWT_SECRET)
GITHUB_TOKEN_ENC_KEY=
# Prefijo de referencia de tickets (KAN-32 → ticket 32)
GITHUB_TICKET_PREFIX=KAN
