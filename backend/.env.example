# App
NODE_ENV=development
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=kanbana_user
DB_PASSWORD=
DB_NAME=kanbana_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# Archivos (local dev)
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173

# IA — Gemini (gratis: aistudio.google.com)
GEMINI_API_KEY=

# IA — Ollama (local dev) / Groq (producción)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=

# Supabase Storage (producción)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=kanbana-uploads
