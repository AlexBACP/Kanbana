# Kanbana — Variables de entorno del stack Docker (raíz del proyecto)
# Copia este archivo a .env y rellena los valores reales.
# Este archivo sí se sube a GitHub; el .env real NO.
# ══════════════════════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esto_root
MYSQL_DATABASE=kanbana_db
MYSQL_USER=kanbana_user
MYSQL_PASSWORD=cambia_esto_user

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=cambia_esto_n8n
